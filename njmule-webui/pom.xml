<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.njmule</groupId>
        <artifactId>njmule-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>njmule-webui</artifactId>
    <name>njMule Web UI</name>
    <description>Web interface of njMule: server-rendered pages and a JSON remote-control API over the engine's public API.</description>

    <dependencies>
        <dependency>
            <groupId>org.njmule</groupId>
            <artifactId>njmule-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <!-- The tests reach the web interface with the JDK HTTP client, which the
                                     modules themselves no longer read. -->
                                <arg>--add-modules</arg>
                                <arg>java.net.http</arg>
                                <arg>--add-reads</arg>
                                <arg>org.njmule.webui=java.net.http</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The tests use the JDK HTTP client. -->
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Dfile.encoding=UTF-8 -Dnjmule.upnp.disabled=true -Dnjmule.defaultlists.disabled=true --add-modules java.net.http --add-reads org.njmule.webui=java.net.http</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
