{
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "jsx": "preserve",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "moduleResolution": "bundler",
        "module": "esnext",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@site/*": ["./*"]
        },
        "types": ["@docusaurus/module-type-aliases", "@docusaurus/theme-classic", "node"]
    },
    "include": ["src", "plugins", "scripts", "docusaurus.config.ts", "sidebars.ts", "sidebarsDeveloper.ts"],
    "exclude": [".docusaurus", "build", "node_modules"]
}
