<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.njmule</groupId>
        <artifactId>njmule-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>njmule-testkit</artifactId>
    <name>njMule Test Kit</name>
    <description>Test doubles for njMule: manual clock, fake servers and peers, golden vectors.</description>

    <build>
        <plugins>
            <!-- The end-to-end tests here exercise the core and the launcher: one coverage report
                 for all of them, which SonarQube Cloud reads too. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The launcher and the web interface are test-only dependencies: let the tests read
                         their modules, and the JDK HTTP client. -->
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Dfile.encoding=UTF-8 --add-modules java.net.http --add-reads org.njmule.testkit=org.njmule.app,org.njmule.webui,java.net.http</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <!-- The test kit implements core types exported only to it. -->
                        <arg>-Xlint:-exports</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.njmule</groupId>
            <artifactId>njmule-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.njmule</groupId>
            <artifactId>njmule-app</artifactId>
            <version>${project.version}</version>
            <!-- Runtime rather than test, so the coverage report aggregates the launcher too. -->
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
