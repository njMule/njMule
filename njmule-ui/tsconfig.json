{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["vite/client"],
        "paths": {
            "@generated/*": ["./build/generated/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
