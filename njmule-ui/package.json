{
    "name": "njmule-ui",
    "private": true,
    "version": "0.0.0",
    "description": "njMule's user interface: the desktop app's window and the web interface",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "api": "openapi-typescript ../njmule-core/src/main/resources/org/njmule/core/remote/openapi.yaml -o build/generated/api.d.ts",
        "build": "npm run api && vue-tsc --noEmit && vite build",
        "dev": "vite",
        "test": "npm run api && vitest run",
        "lint": "prettier --check src index.html vite.config.ts",
        "format": "prettier --write src index.html vite.config.ts"
    },
    "dependencies": {
        "@tanstack/vue-table": "9.3.1",
        "@tanstack/vue-virtual": "3.13.50",
        "@tauri-apps/api": "2.12.4",
        "eventsource-parser": "4.1.3",
        "openapi-fetch": "0.17.0",
        "reka-ui": "2.11.0",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "@vue/tsconfig": "0.9.1",
        "happy-dom": "21.0.4",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "vue-tsc": "3.3.14"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
