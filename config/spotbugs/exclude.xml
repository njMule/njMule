    SpotBugs exclusions. Every entry must carry a justification.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Test code: fixtures intentionally use temporary paths and expose internals. -->
    <Match>
        <Class name="~.*Test(s)?(\$.*)?"/>
    </Match>

    <!-- Log forging is neutralised centrally: the Logback encoder patterns replace CR/LF in every
         message (org.njmule.app.logging.LoggingSetup), so call sites need no sanitising. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Paths come from the user's own configuration or OS conventions, never from the network;
         network-supplied names go through PathSanitizer (introduced in M3). -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
        <Or>
            <Class name="org.njmule.core.config.AppDirectories"/>
            <Class name="org.njmule.app.CommandLine"/>
        </Or>
    </Match>
    <!-- MD4, MD5 and SHA-1 are mandated by the eD2K/Kad protocols (file hashes, AICH, obfuscation
         keys, data file keys) for interoperability; they protect no secret. -->
    <Match>
        <Or>
            <Bug pattern="WEAK_MESSAGE_DIGEST_SHA1"/>
            <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
        </Or>
        <Or>
            <Package name="~org\.njmule\.core\.files\.hash.*"/>
            <Package name="~org\.njmule\.core\.protocol\..*"/>
            <Package name="~org\.njmule\.core\.crypto.*"/>
            <Package name="~org\.njmule\.core\.persist\.format.*"/>
        </Or>
    </Match>
</FindBugsFilter>
