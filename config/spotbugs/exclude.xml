    SpotBugs exclusions. Every entry must carry a justification.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Test code: fixtures intentionally use temporary paths and expose internals. -->
    <Match>
        <Class name="~.*Test(s)?(\$.*)?"/>
    </Match>

    <!-- Log forging is neutralised centrally: the Logback encoder patterns replace CR/LF in every
         message (org.njmule.app.logging.LoggingSetup), so call sites need no sanitising. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Paths come from the user's own configuration or OS conventions, never from the network;
         network-supplied names go through PathSanitizer (introduced in M3). -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
        <Or>
            <Class name="org.njmule.core.config.AppDirectories"/>
            <Class name="org.njmule.app.LaunchOptions"/>
        </Or>
    </Match>
    <!-- MD4, MD5 and SHA-1 are mandated by the eD2K/Kad protocols (file hashes, AICH, obfuscation
         keys, data file keys) for interoperability; they protect no secret. -->
    <Match>
        <Or>
            <Bug pattern="WEAK_MESSAGE_DIGEST_SHA1"/>
            <Bug pattern="WEAK_MESSAGE_DIGEST_MD5"/>
        </Or>
        <Or>
            <Package name="~org\.njmule\.core\.files\.hash.*"/>
            <Package name="~org\.njmule\.core\.protocol\..*"/>
            <Package name="~org\.njmule\.core\.crypto.*"/>
            <Package name="~org\.njmule\.core\.persist\.format.*"/>
        </Or>
    </Match>

    <!-- RC4 is the key stream of the eD2K/Kad protocol obfuscation, which hides traffic from simple
         filters and is not meant to protect integrity or secrecy. -->
    <Match>
        <Bug pattern="CIPHER_INTEGRITY"/>
        <Class name="org.njmule.core.crypto.Rc4"/>
    </Match>

    <!-- The eD2K and Kad protocols run over plain TCP, optionally obfuscated; TLS would break
         interoperability with every other client and server. -->
    <Match>
        <Or>
            <Bug pattern="UNENCRYPTED_SOCKET"/>
            <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
        </Or>
        <Or>
            <Package name="org.njmule.core.net"/>
            <Package name="org.njmule.testkit"/>
        </Or>
    </Match>

    <!-- Download state (part files, downloads) consists of mutable objects that only the engine
         thread touches; sharing them between the engine's classes is the design, not a leak. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Or>
            <Package name="org.njmule.core.download"/>
            <Package name="org.njmule.core.files"/>
        </Or>
    </Match>
    <!-- A uTP connection exists to hand out its streams, which the connection reads and writes. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="org.njmule.core.utp.UtpConnection"/>
        <Or>
            <Method name="input"/>
            <Method name="output"/>
        </Or>
    </Match>
    <!-- InetAddress has no mutators (IPv6 ones included): a record holding one exposes nothing. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Class name="org.njmule.core.security.SecureIdent$IpBinding"/>
    </Match>
    <!-- The remote-control API shares live services by design: the engine, Jetty's request and
         response of an exchange, and the collectors that the web pages read too. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Package name="org.njmule.core.remote"/>
    </Match>
    <!-- The web interface builds its pages from fixed markup; every text that is not a literal
         goes through Html.text, which escapes it for element content and quoted attributes
         (WebUiPartsTest, WebUiTest), and the Content-Security-Policy forbids scripts. -->
    <Match>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
        <Package name="org.njmule.webui"/>
    </Match>

    <!-- The launch agent that starts njMule at login on macOS is written from fixed markup and our
         own program path and arguments, each escaped for XML element content (AutostartTest). -->
    <Match>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
        <Class name="org.njmule.app.SystemAutostart$MacOs"/>
    </Match>

    <!-- The desktop interface shares observable state on purpose: JavaFX views bind to the
         model's properties and lists, and screens hand out their nodes; all of it lives on the FX
         thread. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Package name="~org\.njmule\.gui(\..*)?"/>
    </Match>

    <!-- Later starts hand their links to the running njMule over the loopback interface only, and
         must prove they can read the secret in the user's configuration directory: nothing leaves
         the computer, so TLS would protect nothing. -->
    <Match>
        <Or>
            <Bug pattern="UNENCRYPTED_SOCKET"/>
            <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
        </Or>
        <Class name="org.njmule.app.LinkHandoff"/>
    </Match>

    <!-- The link association, the folder opener, the Windows service, keeping the computer awake, the
         lookups of the default gateway and of a moved Downloads folder run fixed system tools (reg,
         xdg-mime, the file manager, icacls, netsh, PowerShell, caffeinate, systemd-inhibit, route) or
         njMule's own programs with
         arguments built from our own paths and constants, never from the network; the preview runs the
         player the user chose in the settings on one of our own data files. The command line is a list,
         so no shell parses it. -->
    <Match>
        <Bug pattern="COMMAND_INJECTION"/>
        <Or>
            <Class name="org.njmule.app.LinkAssociation"/>
            <Class name="org.njmule.app.WindowsService$SystemWindows"/>
            <Class name="org.njmule.core.config.KnownFolders"/>
            <Class name="org.njmule.core.engine.KeepAwake"/>
            <Class name="org.njmule.core.upnp.DefaultGateway"/>
            <Class name="org.njmule.gui.infra.Folders"/>
            <Class name="org.njmule.gui.infra.Preview"/>
        </Or>
    </Match>

    <!-- The updates run fixed system tools (hdiutil, ditto, codesign, msiexec through the launcher) and
         njMule's own programs, the installed ones or those unpacked from a package checked against its
         signed update information, with arguments built from our own paths; a window on a remote njMule
         is the installed desktop program again, given the address the user typed. The command line is
         a list, so no shell parses it. -->
    <Match>
        <Bug pattern="COMMAND_INJECTION"/>
        <Or>
            <Class name="org.njmule.core.update.Commands"/>
            <Class name="org.njmule.core.update.Launcher"/>
            <Class name="org.njmule.gui.infra.RemoteConnections"/>
        </Or>
    </Match>

    <!-- The event commands run the program the user set in the settings. Names and messages from
         the network only fill in its arguments, which go as a list, so no shell parses them; on
         Windows, where they travel as one command line, their quotes are replaced first. -->
    <Match>
        <Bug pattern="COMMAND_INJECTION"/>
        <Class name="org.njmule.core.engine.EventCommandRunner"/>
    </Match>
</FindBugsFilter>
