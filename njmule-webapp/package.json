{
    "name": "njmule-webapp",
    "private": true,
    "version": "0.0.0",
    "description": "The browser app of njMule's web interface",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vue-tsc --noEmit && vite build",
        "test": "vitest run",
        "lint": "prettier --check src index.html vite.config.ts",
        "format": "prettier --write src index.html vite.config.ts"
    },
    "dependencies": {
        "element-plus": "2.14.7",
        "vue": "3.5.44",
        "vue-router": "5.4.0"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "@vue/tsconfig": "0.9.1",
        "happy-dom": "21.0.4",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "vue-tsc": "3.3.13"
    }
}
