# SPDX-License-Identifier: GPL-3.0-or-later
#
# Rejects commits with code that is not palantir-java-format formatted or lacks the license header.
# Enable with: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1
if [ -f ./mvnw ]; then mvn_cmd=./mvnw; else mvn_cmd=mvn; fi
if ! "$mvn_cmd" -q -B spotless:check; then
    echo "Formatting check failed: run '$mvn_cmd spotless:apply' and stage the changes." >&2
    exit 1
fi
