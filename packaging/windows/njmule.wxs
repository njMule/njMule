<?xml version="1.0" encoding="UTF-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Salvatore Coppola and the njMule contributors
    SPDX-License-Identifier: GPL-3.0-or-later

    Windows installer (WiX 5): a per-user MSI that needs no administrator rights. The programs go
    to %LOCALAPPDATA%\Programs\njMule, which njMule never writes to; settings and downloads stay
    in the user's folders and survive an uninstall.

    wix build packaging/windows/njmule.wxs -wx -arch x64 -d Version=1.2.3 -d Gui=yes
        -d BinDir=<absolute dir with the executables> -d DocDir=<absolute dir with LICENSE, NOTICE,
        README.md> -o njmule.msi
    (WiX resolves relative directories from this file's own directory.)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package
            Name="njMule"
            Manufacturer="njMule contributors"
            Version="$(var.Version)"
            UpgradeCode="753516BB-36CF-406D-8D2B-DF38A0310EAF"
            Scope="perUserOrMachine"
            Language="1033">
        <SummaryInformation Description="njMule $(var.Version): eD2K and Kad file sharing"/>
        <MajorUpgrade DowngradeErrorMessage="A newer version of njMule is already installed."/>
        <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
        <!-- perUserOrMachine installs for the current user by default (no UAC prompt);
             MSIINSTALLPERUSER="" installs for every user. -->

        <Icon Id="njmule.ico" SourceFile="branding/generated/njmule.ico"/>
        <Property Id="ARPPRODUCTICON" Value="njmule.ico"/>
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/njMule/njMule"/>
        <Property Id="ARPHELPLINK" Value="https://github.com/njMule/njMule/issues"/>
        <Property Id="ARPNOMODIFY" Value="1"/>

        <!-- Windows redirects it to %LOCALAPPDATA%\Programs for a per-user installation. -->
        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALLFOLDER" Name="njMule"/>
        </StandardDirectory>

        <ComponentGroup Id="Programs" Directory="INSTALLFOLDER">
            <Files Include="$(var.BinDir)\**"/>
            <File Source="$(var.DocDir)\LICENSE" Name="LICENSE.txt"/>
            <File Source="$(var.DocDir)\NOTICE" Name="NOTICE.txt"/>
            <File Source="$(var.DocDir)\README.md"/>
            <!-- Tells the update check that this copy came from the installer. -->
            <File Source="$(var.DocDir)\packaging\windows\install.properties"/>
            <!-- The command-line launcher on the user's PATH. -->
            <Component Id="UserPath">
                <Environment
                        Id="UserPath"
                        Name="PATH"
                        Value="[INSTALLFOLDER]"
                        Part="last"
                        Action="set"
                        System="no"/>
                <RemoveFolder Id="RemoveInstallFolder" On="uninstall"/>
                <RegistryValue
                        Root="HKCU"
                        Key="Software\njMule"
                        Name="InstallFolder"
                        Type="string"
                        Value="[INSTALLFOLDER]"
                        KeyPath="yes"/>
            </Component>
        </ComponentGroup>

        <?if $(var.Gui) = yes ?>
        <ComponentGroup Id="Desktop" Directory="ProgramMenuFolder">
            <Component Id="StartMenuShortcut">
                <Shortcut
                        Id="StartMenuShortcut"
                        Name="njMule"
                        Description="eD2K and Kad file sharing"
                        Target="[INSTALLFOLDER]njmule-gui.exe"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="njmule.ico">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="org.njmule.njMule"/>
                </Shortcut>
                <RegistryValue
                        Root="HKCU"
                        Key="Software\njMule"
                        Name="StartMenuShortcut"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
            </Component>
        </ComponentGroup>
        <ComponentGroup Id="DesktopShortcut" Directory="DesktopFolder">
            <Component Id="DesktopShortcut">
                <Shortcut
                        Id="DesktopShortcut"
                        Name="njMule"
                        Description="eD2K and Kad file sharing"
                        Target="[INSTALLFOLDER]njmule-gui.exe"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="njmule.ico">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="org.njmule.njMule"/>
                </Shortcut>
                <RegistryValue
                        Root="HKCU"
                        Key="Software\njMule"
                        Name="DesktopShortcut"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
            </Component>
        </ComponentGroup>

        <!-- The desktop app may have taken the ed2k links: at uninstall it gives them back to
             what opened them before, if it still has them. Not at an upgrade, which keeps them,
             and never a reason to stop the uninstall. The program still exists before
             RemoveFiles; deferred and impersonated, it changes the user's own settings. -->
        <CustomAction
                Id="RestoreLinks"
                Directory="INSTALLFOLDER"
                ExeCommand="&quot;[INSTALLFOLDER]njmule-gui.exe&quot; --restore-links"
                Execute="deferred"
                Impersonate="yes"
                Return="ignore"/>
        <!-- At uninstall, not at an upgrade nor in a quiet one, the user is asked whether their profile
             (settings, lists, identity, unfinished downloads, caches, logs) goes too, to the Recycle Bin;
             the completed downloads stay. Impersonated: it is the user's own profile. -->
        <CustomAction
                Id="AskProfile"
                Directory="INSTALLFOLDER"
                ExeCommand="&quot;[INSTALLFOLDER]njmule-gui.exe&quot; --uninstall-profile"
                Execute="deferred"
                Impersonate="yes"
                Return="ignore"/>
        <InstallExecuteSequence>
            <Custom
                    Action="RestoreLinks"
                    Before="RemoveFiles"
                    Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
            <Custom
                    Action="AskProfile"
                    After="RestoreLinks"
                    Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt;= 3"/>
        </InstallExecuteSequence>
        <?endif?>

        <!-- njMule as the Windows service "njMule" (as with njmule's service option), for an installation for
             every user: msiexec /i njmule.msi MSIINSTALLPERUSER="" NJMULE_SERVICE=1
             NJMULE_WEBUI_PASSWORD_FILE=<a file holding the web interface password>. The service is
             stopped while its files are replaced, started again after an upgrade, and removed with
             njMule; its profile in %ProgramData%\njMule stays. -->
        <Property Id="NJMULE_SERVICE" Secure="yes"/>
        <Property Id="NJMULE_WEBUI_PASSWORD_FILE" Secure="yes"/>
        <Launch
                Condition="NOT NJMULE_SERVICE OR (Privileged AND NJMULE_WEBUI_PASSWORD_FILE)"
                Message="NJMULE_SERVICE=1 installs for every user (MSIINSTALLPERUSER=&quot;&quot;) and needs NJMULE_WEBUI_PASSWORD_FILE, a file holding the web interface password."/>
        <ComponentGroup Id="Service" Directory="INSTALLFOLDER">
            <Component Id="ServiceControl" Condition="Privileged" Guid="6F1D2B4E-6C55-4E5B-9B0A-2C7E5D9A41B3">
                <ServiceControl Id="StopService" Name="njMule" Stop="both" Wait="yes"/>
                <RegistryValue
                        Root="HKLM"
                        Key="Software\njMule"
                        Name="ServiceControl"
                        Type="integer"
                        Value="1"
                        KeyPath="yes"/>
            </Component>
        </ComponentGroup>
        <CustomAction
                Id="InstallService"
                Directory="INSTALLFOLDER"
                ExeCommand="&quot;[INSTALLFOLDER]njmule.exe&quot; --service=install --webui-password-file &quot;[NJMULE_WEBUI_PASSWORD_FILE]&quot;"
                Execute="deferred"
                Impersonate="no"
                Return="check"/>
        <CustomAction
                Id="StartService"
                Directory="INSTALLFOLDER"
                ExeCommand="&quot;[INSTALLFOLDER]njmule.exe&quot; --service=start"
                Execute="deferred"
                Impersonate="no"
                Return="ignore"/>
        <CustomAction
                Id="UninstallService"
                Directory="INSTALLFOLDER"
                ExeCommand="&quot;[INSTALLFOLDER]njmule.exe&quot; --service=uninstall"
                Execute="deferred"
                Impersonate="no"
                Return="ignore"/>
        <InstallExecuteSequence>
            <Custom Action="InstallService" After="InstallFiles" Condition="NJMULE_SERVICE AND NOT REMOVE"/>
            <!-- An upgrade starts again the service it stopped; where there is none, nothing happens. -->
            <Custom
                    Action="StartService"
                    After="InstallFiles"
                    Condition="Privileged AND NOT NJMULE_SERVICE AND NOT REMOVE AND WIX_UPGRADE_DETECTED"/>
            <Custom
                    Action="UninstallService"
                    Before="RemoveFiles"
                    Condition="Privileged AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
        </InstallExecuteSequence>

        <Feature Id="Main" Title="njMule">
            <ComponentGroupRef Id="Programs"/>
            <ComponentGroupRef Id="Service"/>
            <?if $(var.Gui) = yes ?>
            <ComponentGroupRef Id="Desktop"/>
            <ComponentGroupRef Id="DesktopShortcut"/>
            <?endif?>
        </Feature>
    </Package>
</Wix>
