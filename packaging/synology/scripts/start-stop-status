#!/bin/sh
# SPDX-FileCopyrightText: 2026 Salvatore Coppola and the njMule contributors
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Starts, stops and checks njMule, as the package's own user (conf/privilege). Its settings, logs
# and temporary files live in the package's var folder, its downloads in the shared folder njmule.

VAR="${SYNOPKG_PKGVAR:-/var/packages/${SYNOPKG_PKGNAME}/var}"
BIN="${SYNOPKG_PKGDEST}/bin/njmule"
PID_FILE="${VAR}/njmule.pid"
CONF="${VAR}/config/njmule.properties"
SHARE="/var/packages/${SYNOPKG_PKGNAME}/shares/njmule"

running() {
    [ -s "${PID_FILE}" ] && kill -0 "$(cat "${PID_FILE}")" 2> /dev/null
}

case "$1" in
    start)
        running && exit 0
        # The shared folder exists from the first start on: downloads go there unless chosen otherwise.
        if [ -d "${SHARE}" ] && ! grep -q '^dirs\.incoming=' "${CONF}" 2> /dev/null; then
            mkdir -p "${VAR}/config"
            printf 'dirs.incoming=%s\n' "$(readlink -f "${SHARE}")" >> "${CONF}"
        fi
        # The log goes to rotated files under ${VAR}/logs; only fatal errors reach stderr.
        "${BIN}" --config-dir "${VAR}" > /dev/null 2> "${VAR}/njmule.err" &
        echo $! > "${PID_FILE}"
        exit 0
        ;;
    stop)
        if running; then
            pid=$(cat "${PID_FILE}")
            # SIGTERM saves the downloads and settings first.
            kill -TERM "${pid}"
            waited=0
            while kill -0 "${pid}" 2> /dev/null && [ "${waited}" -lt 60 ]; do
                sleep 1
                waited=$((waited + 1))
            done
            kill -0 "${pid}" 2> /dev/null && kill -KILL "${pid}"
        fi
        rm -f "${PID_FILE}"
        exit 0
        ;;
    status)
        running && exit 0
        [ -f "${PID_FILE}" ] && exit 1
        exit 3
        ;;
    *)
        exit 0
        ;;
esac
