[Desktop Entry]
Type=Application
Name=njMule
GenericName=eD2K and Kad file sharing
GenericName[it]=Condivisione file eD2K e Kad
Comment=Share files on the eD2K and Kad networks
Comment[it]=Condividi file sulle reti eD2K e Kad
Exec=njMule %u
Icon=org.njmule.njMule
Terminal=false
Categories=Network;P2P;FileTransfer;
MimeType=x-scheme-handler/ed2k;
Keywords=ed2k;kad;emule;p2p;
