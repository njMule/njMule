//
// Icon and version information of the Windows executable, shown by Explorer and Task Manager.
// Maven fills in the version; rc.cmd defines its numbers NJ_MAJOR, NJ_MINOR and NJ_PATCH.

1 ICON "njmule.ico"

1 VERSIONINFO
FILEVERSION NJ_MAJOR, NJ_MINOR, NJ_PATCH, 0
PRODUCTVERSION NJ_MAJOR, NJ_MINOR, NJ_PATCH, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "njMule"
            VALUE "FileDescription", "njMule"
            VALUE "FileVersion", "${project.version}"
            VALUE "InternalName", "njmule-gui"
            VALUE "LegalCopyright", "Copyright (C) 2026 Salvatore Coppola and the njMule contributors. GPL-3.0-or-later."
            VALUE "OriginalFilename", "njmule-gui.exe"
            VALUE "ProductName", "njMule"
            VALUE "ProductVersion", "${project.version}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
