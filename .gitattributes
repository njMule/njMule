# Linux (LF) line endings everywhere, in the repository and in every checkout.
* text=auto eol=lf

# cmd.exe mis-parses labels in batch files with LF endings: the only CRLF exception.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.icns binary
*.gif binary
*.jpg binary
*.wav binary
*.met binary
*.dat binary
*.part binary
*.bin binary
